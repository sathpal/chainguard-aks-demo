# "The way most teams start": official upstream image, single stage, root, shell,
# package manager, and a full Debian userland shipped to production.
FROM python:3.13-slim

WORKDIR /app
COPY app/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY app/main.py .

ENV IMAGE_FLAVOR=upstream PORT=8080
EXPOSE 8080
CMD ["python", "main.py"]
